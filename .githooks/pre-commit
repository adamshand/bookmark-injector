#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! git diff --quiet -- manifest.json package.json package-lock.json; then
  echo "Version files have unstaged changes; stage or stash them before committing." >&2
  exit 1
fi

node scripts/bump-version.mjs
git add manifest.json package.json package-lock.json
